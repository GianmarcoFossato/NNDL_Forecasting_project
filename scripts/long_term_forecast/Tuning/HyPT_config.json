{
  "min_resource": 3,
  "reduction_factor": 2,
  "min_early_stopping_rate": 0,
  "n_trials": 30,
  "parameters": {
    "learning_rate": {
      "type": "categorical",
      "kwargs": {
        "choices": [0.0001, 0.0003, 0.0005, 0.001]
      }
    },
    "batch_size": {
      "type": "categorical",
      "kwargs": {
        "choices": [16, 32, 64]
      }
    },
    "train_epochs": {
      "type": "categorical",
      "kwargs": {
        "choices": [10, 15, 20]
      }
    },
    "d_model": {
      "type": "categorical",
      "kwargs": {
        "choices": [128, 256, 512]
      }
    },
    "d_ff_mult": {
      "type": "categorical",
      "kwargs": {
        "choices": [1, 2, 4]
      }
    },
    "n_heads": {
      "type": "categorical",
      "kwargs": {
        "choices": [4, 8]
      }
    },
    "patch_len": {
      "type": "categorical",
      "kwargs": {
        "choices": [8, 16]
      }
    },
    "dropout": {
      "type": "float",
      "kwargs": {
        "low": 0.05,
        "high": 0.3,
        "step": 0.05
      }
    },
    "top_k": {
      "type": "int",
      "kwargs": {
        "low": 3,
        "high": 5,
        "step": 1
      }
    },
    "branch_dropout": {
      "type": "float",
      "kwargs": {
        "low": 0.05,
        "high": 0.25,
        "step": 0.05
      }
    },
    "branch_warmup_epochs": {
      "type": "categorical",
      "kwargs": {
        "choices": [2, 3, 5]
      }
    }
  },
  "special_cases": {
    "HyPT": {
      "parameters": {
        "e_layers": {
          "type": "categorical",
          "kwargs": {
            "choices": [1, 2, 3]
          }
        },
        "d_period": {
          "type": "categorical",
          "kwargs": {
            "choices": [16, 32, 64]
          }
        }
      }
    }
  }
}